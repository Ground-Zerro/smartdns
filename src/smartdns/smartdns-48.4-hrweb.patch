+static int _dns_client_server_sock_type(dns_server_type_t server_type)
+{
+	switch (server_type) {
+	case DNS_SERVER_UDP:
+	case DNS_SERVER_QUIC:
+	case DNS_SERVER_HTTP3:
+	case DNS_SERVER_MDNS:
+		return SOCK_DGRAM;
+	default:
+		return SOCK_STREAM;
+	}
+}
+
+int _dns_client_server_refresh_ip(struct dns_server_info *server_info, const char *new_ip)
+{
+	struct addrinfo *gai = NULL;
+	char port_s[8];
+	char old_ip[DNS_MAX_HOSTNAME] = {0};
+
+	if (strncmp(server_info->ip, new_ip, sizeof(server_info->ip)) == 0) {
+		return 0;
+	}
+
+	snprintf(port_s, sizeof(port_s), "%d", server_info->port);
+	gai = _dns_client_getaddr(new_ip, port_s, _dns_client_server_sock_type(server_info->type), 0);
+	if (gai == NULL) {
+		return -1;
+	}
+
+	if (gai->ai_addrlen > sizeof(server_info->in6)) {
+		freeaddrinfo(gai);
+		return -1;
+	}
+
+	pthread_mutex_lock(&client.server_list_lock);
+	pthread_mutex_lock(&server_info->lock);
+	safe_strncpy(old_ip, server_info->ip, sizeof(old_ip));
+	server_info->recv_buff.len = 0;
+	server_info->send_buff.len = 0;
+	_dns_client_close_socket(server_info);
+	if (server_info->ssl_session) {
+		SSL_SESSION_free(server_info->ssl_session);
+		server_info->ssl_session = NULL;
+	}
+
+	safe_strncpy(server_info->ip, new_ip, sizeof(server_info->ip));
+	server_info->ai_family = gai->ai_family;
+	server_info->ai_addrlen = gai->ai_addrlen;
+	memcpy(&server_info->addr, gai->ai_addr, gai->ai_addrlen);
+
+	if (server_info->ping_host) {
+		fast_ping_stop(server_info->ping_host);
+		server_info->ping_host =
+			fast_ping_start(PING_TYPE_DNS, new_ip, 0, 60000, 1000, _dns_client_server_update_ttl, server_info);
+	}
+
+	if (server_info->is_already_prohibit) {
+		_dns_server_dec_prohibit_server_num(server_info);
+	}
+	server_info->prohibit = 0;
+	server_info->is_already_prohibit = 0;
+	atomic_set(&server_info->noreply_count, 0);
+	time(&server_info->last_send);
+	time(&server_info->last_recv);
+	pthread_mutex_unlock(&server_info->lock);
+	pthread_mutex_unlock(&client.server_list_lock);
+
+	freeaddrinfo(gai);
+	tlog(TLOG_INFO, "server %s address changed: %s -> %s", server_info->host, old_ip, new_ip);
+	return 1;
+}
