+static int _dns_client_server_pending_refresh(struct dns_server_info *server_info)
+{
+	struct dns_server_pending *pending = NULL;
+
+	pending = zalloc(1, sizeof(*pending));
+	if (pending == NULL) {
+		return -1;
+	}
+
+	safe_strncpy(pending->host, server_info->host, DNS_HOSTNAME_LEN);
+	pending->port = server_info->port;
+	pending->type = server_info->type;
+	pending->ping_time_v4 = -1;
+	pending->ping_time_v6 = -1;
+	pending->refresh_server = server_info;
+	_dns_client_server_pending_get(pending);
+	INIT_LIST_HEAD(&pending->group_list);
+	INIT_LIST_HEAD(&pending->retry_list);
+	memcpy(&pending->flags, &server_info->flags, sizeof(struct client_dns_server_flags));
+
+	pthread_mutex_lock(&pending_server_mutex);
+	list_add_tail(&pending->list, &pending_servers);
+	atomic_set(&client.run_period, 1);
+	pthread_mutex_unlock(&pending_server_mutex);
+
+	_dns_client_do_wakeup_event();
+	tlog(TLOG_INFO, "server %s (%s) does not reply, resolve its host name again", server_info->host, server_info->ip);
+	return 0;
+}
+
+void _dns_client_refresh_named_servers(void)
+{
+	static int tick = 0;
+	struct dns_server_info *server_info = NULL;
+	struct dns_server_info *tmp = NULL;
+	LIST_HEAD(candidates);
+	time_t now = 0;
+
+	if (++tick % 5 != 0 || dns_client_has_bootstrap_dns == 0) {
+		return;
+	}
+
+	time(&now);
+	pthread_mutex_lock(&client.server_list_lock);
+	list_for_each_entry_safe(server_info, tmp, &client.dns_server_list, list)
+	{
+		if (server_info->resolved_by_name == 0 || server_info->refresh_pending ||
+			atomic_read(&server_info->noreply_count) < DNS_SERVER_REFRESH_NOREPLY ||
+			now - server_info->last_refresh < DNS_SERVER_REFRESH_INTERVAL) {
+			continue;
+		}
+
+		server_info->refresh_pending = 1;
+		server_info->last_refresh = now;
+		list_add(&server_info->check_list, &candidates);
+		dns_client_server_info_get(server_info);
+	}
+	pthread_mutex_unlock(&client.server_list_lock);
+
+	list_for_each_entry_safe(server_info, tmp, &candidates, check_list)
+	{
+		list_del_init(&server_info->check_list);
+		if (_dns_client_server_pending_refresh(server_info) != 0) {
+			server_info->refresh_pending = 0;
+			dns_client_server_info_release(server_info);
+		}
+	}
+}
